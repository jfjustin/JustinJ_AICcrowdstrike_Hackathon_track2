# Optional overrides — the app runs fine with none of these set.
# Local explain provider (private, on-device, no data leaves the machine):
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b

# Cloud explain provider: NOT read from here. The Anthropic API key is pasted
# into the chatbox in the browser's detail panel and used for one request —
# it is never stored server-side. ANTHROPIC_MODEL just controls which model
# that cloud call targets.
ANTHROPIC_MODEL=claude-sonnet-5

PORT=8713
